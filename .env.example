# ============================================================================
# reef.dev environment variables
# Copy to .env.local for local dev, or set these in Vercel → Settings → Env Vars.
# NONE are required for the public site to render, but the admin API needs them.
# ============================================================================

# --- Admin authentication -----------------------------------------------------
# ADMIN_PASSWORD: the primary admin password, verified server-side by /api/login.
# Never shipped to the browser. If unset, the hashed backup password still works.
ADMIN_PASSWORD=""

# SESSION_SECRET: HMAC key used to sign admin session tokens. Strongly recommended
# in production. Use a long random string, e.g. `openssl rand -hex 32`.
# If unset, a deterministic key is derived from ADMIN_PASSWORD (still works, but
# rotating ADMIN_PASSWORD then invalidates existing sessions).
SESSION_SECRET=""

# DISABLE_BACKUP_PASSWORD: set to "1" to turn off the built-in emergency backup
# password. Leave unset to keep the original password working as a fallback.
DISABLE_BACKUP_PASSWORD=""

# --- Persistence (at least one recommended for cross-device saves) ------------
# Created automatically when you add a Vercel KV store (Storage → Create → KV).
KV_URL=""
# Created automatically when you add a Vercel Blob store (Storage → Create → Blob).
BLOB_READ_WRITE_TOKEN=""

# --- Optional -----------------------------------------------------------------
# GITHUB_TOKEN: raises the GitHub API rate limit for /api/github-repo. Use a
# fine-grained token with NO scopes (public read only).
GITHUB_TOKEN=""
